# Gemini API (server-side only — never expose to browser or logs)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_STRATEGIST_MODEL=gemini-3.1-flash-lite-preview

# Phase 6 Dual-Brain Engine (dual | gemini_live | auto)
OPENBOT_BRAIN_MODE=dual
OPENBOT_SYSTEM1_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-12b
OPENBOT_SYSTEM1_TIMEOUT_S=5.5
OPENBOT_SYSTEM1_INTERVAL_S=0.2
OPENBOT_SYSTEM1_WIDTH=768
OPENBOT_SYSTEM1_HEIGHT=432
OPENBOT_SYSTEM1_JPEG_QUALITY=62
OPENBOT_STRATEGIST_INTERVAL_S=25.0
OPENBOT_STRATEGIST_TIMEOUT_S=25.0

# Target Game URL & Fair-Play Guard
OPENBOT_TARGET_URL=http://localhost:9000
OPENBOT_ALLOW_PUBLIC=false

# Local Python Bridge Server
OPENBOT_BRIDGE_HOST=127.0.0.1
OPENBOT_BRIDGE_PORT=8765

# Chrome DevTools MCP / CDP Endpoint (use 19222 if 9222 is busy)
OPENBOT_CDP_URL=http://127.0.0.1:19222

# Human-like Action Rate Limiter
OPENBOT_MAX_APM=45
