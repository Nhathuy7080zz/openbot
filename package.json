{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time OpenFront AI bot using Gemini Live API over WebRTC and Chrome DevTools MCP/CDP",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run test:coverage",
    "bot": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^16.6.1",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome-remote-interface": "^0.34.1",
    "@types/node": "^22.20.7",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
